# 로컬에서 직접 스크립트를 테스트할 때 참고용입니다.
# 실제 운영에서는 이 값들을 GitHub Secrets / Cloudflare Worker Secrets에 등록하고
# 이 파일 자체는 절대 커밋하지 마세요 (.gitignore에 이미 포함되어 있음).

# --- YouTube ---
YOUTUBE_API_KEY=

# --- SendGrid (이메일 발송) ---
SENDGRID_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_TO=you@yourdomain.com

# --- 트리거 토큰 서명용 공유 비밀키 (GitHub Actions <-> Cloudflare Worker 동일 값) ---
TRIGGER_SECRET=change-me-to-a-long-random-string

# --- 알림 메일의 버튼이 가리킬 Cloudflare Worker 주소 ---
TRIGGER_BASE_URL=https://sns-trend-report-trigger.your-subdomain.workers.dev/trigger
